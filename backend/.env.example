# Copy this file to .env and fill in your actual keys
# NEVER commit .env to git

DEEPSEEK_API_KEY=your_deepseek_api_key_here        # Required — get from platform.deepseek.com
FRED_API_KEY=your_fred_api_key_here                # Required for macro data — free at fred.stlouisfed.org
ALLOWED_ORIGIN=https://your-frontend-domain.com    # Set to your frontend URL before deploying
ENVIRONMENT=production                             # production or development
RATE_LIMIT=5/minute                                # Rate limit per IP (e.g. 10/minute, 100/hour)
DEMO_ACCESS_TOKEN=                                 # Optional — set a random string to gate public demos
